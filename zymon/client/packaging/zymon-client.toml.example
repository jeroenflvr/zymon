# zymon-client configuration. `zymon-client init` writes a file like this one for the host it runs on.

[identity]
hostname = "pi4.lan"      # must match the host name in the Xymon server's hosts.cfg; dots are commafied on the wire
os = "linux"              # OSTAG sent to the server; selects the server-side parser (linux, darwin, or e.g. "rhel")
class = "linux"           # client class used for analysis.cfg CLASS= rules

[servers]
list = ["192.168.1.10", "backup.example.org:1984"]   # every message goes to every server
connect_timeout_s = 10
read_timeout_s = 15
retries = 3

[schedule]
interval_s = 300
jitter_s = 30

[exec]
timeout_s = 20            # hard limit for each external command (ps, who, netstat, ...)

[sections]                # false = detected but disabled; a missing key = not applicable on this host
date = true
uname = true
osversion = true
uptime = true
who = true
df = true
inode = true
mount = true
free = true
ifconfig = true
route = true
netstat = true
ports = true
ifstat = true
mdstat = true
smart = true              # smartctl found and usable; also sends the `smart` status column
ps = true
nproc = true
top = true
vmstat = true
cpuinfo = true
cputemp = true            # Linux only; also sends the `cputemp` status column
gpu = true                # Linux, discrete NVIDIA cards via nvidia-smi; also sends the `gpu` status column
crontab = true
docker = false
clientversion = true
clock = true

[docker]
socket = "/var/run/docker.sock"
must_run = []             # e.g. ["nginx", "db"]: sends status MACHINE.docker red when one is not running
status_column = "docker"

[cputemp]
warn_c = 70.0             # yellow at or above (the Pi throttles at 80)
panic_c = 80.0            # red at or above
status_column = "cputemp"

[smart]
devices = []              # smartctl arguments per disk, e.g. ["/dev/sda", "/dev/sdb -d sat"]; empty = `smartctl --scan-open`
status_column = "smart"

[gpu]
temp_warn_c = 80.0        # yellow at or above
temp_panic_c = 90.0       # red at or above
mem_warn_pct = 90.0       # percent of GPU memory in use; yellow at or above
mem_panic_pct = 98.0      # red at or above; raise both above 100 for frameworks that reserve all memory up front
status_column = "gpu"

[info]                    # snapshot taken by `init`, informational only
model = "Raspberry Pi Zero W Rev 1.1"
cpu_model = "ARMv6-compatible processor rev 7 (v6l)"
cpu_arch = "7"
cores = 1
hardware = "BCM2835"
revision = "9000c1"
arch = "armv6l"
